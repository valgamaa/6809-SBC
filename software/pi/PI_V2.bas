100 REM PI BY MACHIN'S FORMULA - PURE BASIC VERSION
110 REM PI/4 = 4*ARCTAN(1/5) - ARCTAN(1/239)
120 REM ONE DECIMAL DIGIT PER BYTE IN PAGED RAM
130 REM SELECT REGISTER $F280, 4K WINDOW AT $E000-$EFFF
140 REM BLOCK 14 IS THE NATIVE $E000 RAM. MAP IT BACK
150 REM IN (GOSUB 9200) BEFORE EVERY PRINT OR INPUT.
160 R0=62080
170 W0=57344
180 C=-1
190 GOSUB 9200
200 REM BUFFERS: 28 BLOCKS (114688 DIGITS) EACH
210 P0=16
220 T0=44
230 A0=72
240 B0=100
250 DIM P9(6)
260 FOR I=0 TO 6
270 READ P9(I)
280 NEXT I
282 REM ---- MACHINE CODE: PARAMETERS AT $C100, DIVIDE AT $C110
284 P1=HEX("C100")
286 D1=HEX("C110")
288 U0=HEX("BFFD")
289 GOSUB 9500
290 DATA 0,0,4,1,8,4,1
300 INPUT "NUMBER OF DIGITS";N1
310 N=N1+6
320 IF N<=65535 THEN 350
330 PRINT "TOO MANY DIGITS"
340 GOTO 300
350 REM ---- ARCTAN(1/5), STARTING FROM 1/5 = 0.2
360 PRINT "ARCTAN(1/5)"
370 Q3=A0
380 GOSUB 8800
390 Q3=P0
400 GOSUB 8800
410 Q=P0
420 I=0
430 D=2
440 GOSUB 9100
450 X2=25
460 Z=A0
470 GOSUB 7000
480 REM ---- ARCTAN(1/239), 1/239 = 0.0041841 REPEATING
490 GOSUB 9200
500 PRINT "ARCTAN(1/239)"
510 Q3=B0
520 GOSUB 8800
530 Q=P0
540 FOR I=0 TO N-1
550 D=P9(I-7*INT(I/7))
560 GOSUB 9100
570 NEXT I
580 X2=57121
590 Z=B0
600 GOSUB 7000
610 REM ---- PI = 4*(4*ARCTAN(1/5) - ARCTAN(1/239))
620 Q3=A0
630 V=4
640 GOSUB 8700
650 Q2=B0
660 Q3=A0
670 S=-1
680 F=0
690 GOSUB 8300
700 Q3=A0
710 V=4
720 GOSUB 8700
730 I0=E
740 REM ---- PRINT, 50 DIGITS PER LINE
750 GOSUB 9200
760 PRINT
770 PRINT CHR$(48+I0);".";
780 L$=""
790 FOR I=0 TO N1-1
800 Q=A0
810 GOSUB 9000
820 L$=L$+CHR$(48+D)
830 IF LEN(L$)=50 THEN 860
840 IF I=N1-1 THEN 860
850 GOTO 890
860 GOSUB 9200
862 IF I<50 THEN 870
864 PRINT "  ";
870 PRINT L$
880 L$=""
890 NEXT I
900 GOSUB 9200
910 END
7000 REM ---- ARCTAN SERIES
7010 REM BUFFER P0 HOLDS 1/X, X2=X*X, RESULT ADDED INTO BUFFER Z
7020 REM F = INDEX OF FIRST NON-ZERO DIGIT OF P (SKIPS LEADING ZEROS)
7030 M=0
7040 S=1
7050 F=0
7060 IF F>=N THEN 7290
7070 REM T = P/(2M+1)
7080 Q2=P0
7090 Q3=T0
7100 V=2*M+1
7110 GOSUB 8000
7120 REM Z = Z + S*T
7130 Q2=T0
7140 Q3=Z
7150 GOSUB 8300
7160 REM P = P/X2, IN PLACE
7170 Q2=P0
7180 Q3=P0
7190 V=X2
7200 GOSUB 8000
7210 F=F1
7220 M=M+1
7230 S=-S
7240 IF INT(M/10)*10<>M THEN 7060
7250 GOSUB 9200
7260 PRINT "TERM";M;"  LEADING ZEROS";F
7270 GOTO 7060
7290 RETURN
8000 REM ---- DIVIDE BUFFER Q2 BY V INTO BUFFER Q3, DIGITS F TO N-1
8010 REM F1 RETURNS THE FIRST NON-ZERO QUOTIENT DIGIT (N IF NONE)
8020 REM MACHINE CODE VERSION - SEE PIDIV.ASM
8030 DPOKE P1,Q2
8040 DPOKE P1+2,Q3
8050 DPOKE P1+4,N
8060 DPOKE P1+6,F
8070 DPOKE P1+8,V
8080 DPOKE U0,D1
8090 X=USR(0)
8100 F1=PEEK(P1+12)*256+PEEK(P1+13)
8110 C=14
8120 RETURN
8300 REM ---- ADD S*(BUFFER Q2) INTO BUFFER Q3, DIGITS N-1 DOWN TO F
8310 REM S=1 ADDS, S=-1 SUBTRACTS
8320 E=0
8330 FOR I=N-1 TO F STEP -1
8340 Q=Q2
8350 GOSUB 9000
8360 W1=D
8370 Q=Q3
8380 GOSUB 9000
8390 D=D+S*W1+E
8400 GOSUB 8600
8410 GOSUB 9100
8420 NEXT I
8430 REM CARRY OR BORROW INTO DIGITS ABOVE F
8440 I=F-1
8450 IF E=0 THEN 8530
8460 IF I<0 THEN 8530
8470 GOSUB 9000
8480 D=D+E
8490 GOSUB 8600
8500 GOSUB 9100
8510 I=I-1
8520 GOTO 8450
8530 RETURN
8600 REM ---- NORMALISE DIGIT D, E RETURNS CARRY (+1) OR BORROW (-1)
8610 E=0
8620 IF D>=0 THEN 8650
8630 D=D+10
8640 E=-1
8650 IF D<10 THEN 8680
8660 D=D-10
8670 E=1
8680 RETURN
8700 REM ---- MULTIPLY BUFFER Q3 BY SMALL INTEGER V, IN PLACE
8710 REM E RETURNS THE CARRY OUT OF THE TOP (INTEGER PART)
8720 E=0
8730 Q=Q3
8740 FOR I=N-1 TO 0 STEP -1
8750 GOSUB 9000
8760 D=D*V+E
8770 E=INT(D/10)
8780 D=D-E*10
8790 GOSUB 9100
8795 NEXT I
8798 RETURN
8800 REM ---- CLEAR BUFFER Q3 TO ZERO
8810 Q=Q3
8820 D=0
8830 FOR I=0 TO N-1
8840 GOSUB 9100
8850 NEXT I
8860 RETURN
9000 REM ---- GET DIGIT I OF BUFFER Q INTO D
9010 K=Q+INT(I/4096)
9020 IF K=C THEN 9050
9030 POKE R0,K
9040 C=K
9050 D=PEEK(W0+I-(K-Q)*4096)
9060 RETURN
9100 REM ---- PUT D INTO DIGIT I OF BUFFER Q
9110 K=Q+INT(I/4096)
9120 IF K=C THEN 9150
9130 POKE R0,K
9140 C=K
9150 POKE W0+I-(K-Q)*4096,D
9160 RETURN
9200 REM ---- MAP NATIVE BLOCK 14 BACK IN BEFORE PRINT/INPUT
9210 POKE R0,14
9220 C=14
9230 RETURN
9500 REM ---- LOAD MACHINE CODE DIVIDE INTO $C110-$C22C
9510 S9=0
9520 FOR I=D1 TO D1+284
9530 READ D
9540 POKE I,D
9550 S9=S9+D
9560 NEXT I
9570 IF S9=37202 THEN 9600
9580 PRINT "CHECKSUM ERROR IN DATA LINES"
9590 STOP
9600 RETURN
