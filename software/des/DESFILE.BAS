10 REM DESFILE - ENCRYPT/DECRYPT A TEXT FILE WITH THE MC6859 DSD
20 REM CIPHERTEXT IS WRITTEN AS HEX TEXT, 64 HEX CHARS PER LINE
30 REM DES ECB MODE, LAST BLOCK PADDED WITH $00 BYTES
40 DIM K(7),B(7),R(7)
50 D0=HEX("F278"): REM W  WRITE DATA (BYTES 1-7)
60 D1=HEX("F279"): REM W  RESET
70 D2=HEX("F27A"): REM R  STATUS (D7=PARITY ERR, D6=BUSY)
80 D4=HEX("F27C"): REM W  DECIPHER TRIGGER / R READ DATA
90 D5=HEX("F27D"): REM W  ENCIPHER TRIGGER
100 REM OFFSET 2 W = ENTER MAJOR KEY, R = STATUS (SEE D2)
110 H$="0123456789ABCDEF"
120 INPUT "ENCRYPT OR DECRYPT (E/D)";M$
130 IF M$<>"E" AND M$<>"D" THEN 120
140 INPUT "INPUT FILE";I$
150 INPUT "OUTPUT FILE";O$
160 PRINT "KEY (UP TO 8 CHARS): ";
170 INPUT LINE K$
180 GOSUB 2000
190 ON ERROR GOTO 9000
200 OPEN OLD I$ AS 1
210 OPEN NEW O$ AS 2
220 N=0: L$="": P$=""
230 IF M$="D" THEN 600
290 REM ---- ENCRYPT: TEXT LINES (WITH CR) -> 8-BYTE BLOCKS ----
300 INPUT LINE #1,A$
310 A$=A$+CHR$(13)
320 FOR J=1 TO LEN(A$)
330 B(N)=ASC(MID$(A$,J,1))
340 N=N+1
350 IF N=8 THEN GOSUB 3000
360 NEXT J
370 GOTO 300
390 REM ---- END OF PLAINTEXT: PAD AND FLUSH ----
400 IF N=0 THEN 450
410 FOR J=N TO 7
420 B(J)=0
430 NEXT J
440 GOSUB 3000
450 IF LEN(P$)>0 THEN PRINT #2,P$
460 GOTO 900
590 REM ---- DECRYPT: HEX LINES -> 8-BYTE BLOCKS ----
600 INPUT LINE #1,A$
605 IF LEN(A$)<2 THEN 600
610 FOR J=1 TO LEN(A$)-1 STEP 2
620 X=ASC(MID$(A$,J,1))-48
630 IF X>9 THEN X=X-7
640 Y=ASC(MID$(A$,J+1,1))-48
650 IF Y>9 THEN Y=Y-7
660 B(N)=16*X+Y
670 N=N+1
680 IF N=8 THEN GOSUB 3500
690 NEXT J
700 GOTO 600
790 REM ---- END OF CIPHERTEXT ----
800 IF LEN(L$)>0 THEN PRINT #2,L$
810 IF N<>0 THEN PRINT "WARNING: INPUT WAS NOT WHOLE 8-BYTE BLOCKS"
900 CLOSE 1,2
910 POKE D1,0
920 PRINT "DONE"
930 END
1990 REM ---- BUILD ODD-PARITY KEY FROM K$, LOAD AS MAJOR KEY ----
2000 K$=LEFT$(K$+"        ",8)
2010 FOR I=0 TO 7
2020 W=ASC(MID$(K$,I+1,1))
2030 W=W-128*INT(W/128)
2040 V=2*W
2050 C=0
2060 FOR J=1 TO 7
2070 C=C+W-2*INT(W/2)
2080 W=INT(W/2)
2090 NEXT J
2100 IF C=2*INT(C/2) THEN V=V+1
2110 K(I)=V
2120 NEXT I
2130 POKE D1,0
2140 FOR I=0 TO 7
2150 POKE D2,K(I)
2160 NEXT I
2170 T=0
2180 S=PEEK(D2)
2190 IF S>=128 THEN 2250
2200 IF S<64 THEN 2240
2210 T=T+1
2220 IF T<100 THEN 2180
2230 PRINT "DES BUSY TIMEOUT AFTER KEY LOAD": END
2240 RETURN
2250 PRINT "DES KEY PARITY ERROR": END
2990 REM ---- ENCIPHER B() AND APPEND HEX TO P$ ----
3000 FOR I=0 TO 6
3010 POKE D0,B(I)
3020 NEXT I
3030 POKE D5,B(7)
3040 GOSUB 4000
3050 FOR I=0 TO 7
3060 V=R(I)
3070 P$=P$+MID$(H$,INT(V/16)+1,1)+MID$(H$,V-16*INT(V/16)+1,1)
3080 NEXT I
3090 IF LEN(P$)<64 THEN 3120
3100 PRINT #2,P$
3110 P$=""
3120 N=0
3130 RETURN
3490 REM ---- DECIPHER B() AND REBUILD TEXT LINES ----
3500 FOR I=0 TO 6
3510 POKE D0,B(I)
3520 NEXT I
3530 POKE D4,B(7)
3540 GOSUB 4000
3550 FOR I=0 TO 7
3560 V=R(I)
3570 IF V=0 THEN 3620
3580 IF V=13 THEN 3610
3590 L$=L$+CHR$(V)
3600 GOTO 3620
3610 PRINT #2,L$: L$=""
3620 NEXT I
3630 N=0
3640 RETURN
3990 REM ---- WAIT FOR NOT BUSY, READ 8 RESULT BYTES INTO R() ----
4000 T=0
4010 S=PEEK(D2)
4020 IF S>=128 THEN 4100
4030 IF S<64 THEN 4060
4040 T=T+1
4050 IF T<100 THEN 4010
4055 PRINT "DES BUSY TIMEOUT": GOTO 9100
4060 FOR I=0 TO 7
4070 R(I)=PEEK(D4)
4080 NEXT I
4090 RETURN
4100 PRINT "DES PARITY ERROR": GOTO 9100
8990 REM ---- ERROR HANDLER: ERR 8 = END OF FILE ----
9000 IF ERR<>8 THEN ON ERROR GOTO
9010 IF M$="D" THEN 9030
9020 RESUME 400
9030 RESUME 800
9100 CLOSE 1,2
9110 POKE D1,0
9120 END
